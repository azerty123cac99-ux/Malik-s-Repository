# Copy to .env.local and fill in. Both values are safe to expose in the browser:
# row-level security, not secrecy of these keys, is what protects the data.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# On Vercel, the Supabase integration sets NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead; the app reads either. If both are set,
# the VITE_ ones win, so don't leave stale VITE_ values in Vercel.
